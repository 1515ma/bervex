---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES, categoryPath } from '../data/catalog';
---

<BaseLayout title="Página não encontrada | BERVEX" description="Esta página não existe ou mudou de endereço." noindex>
  <section class="lost">
    <div class="container">
      <h1 class="lost__title">Piso errado</h1>
      <p class="lost__lead">Esta página não existe ou mudou de endereço. Siga por um destes caminhos:</p>
      <ul class="lost__links">
        <li><a class="link" href="/">Página inicial</a></li>
        <li><a class="link" href="/loja/">Todos os produtos</a></li>
        {CATEGORIES.slice(0, 6).map((c) => <li><a class="link" href={categoryPath(c.id)}>{c.name}</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .lost { min-height: 60svh; display: grid; align-items: center; padding-block: 4rem; }
  .lost__title { font-size: var(--step-h1); }
  .lost__lead { margin: 1.5rem 0 2rem; font-size: var(--step-lead); line-height: 1.35; max-width: 34ch; }
  .lost__links { display: grid; gap: 0.4rem; list-style: none; padding: 0; font-size: var(--step-body); font-weight: 650; }
</style>
