---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { BERVEX_SITE } from '../config/site';
import {
  buildBreadcrumbSchema,
  buildOrganizationSchema,
  buildSchemaGraph,
  buildWebPageSchema,
  buildWebSiteSchema,
  toAbsoluteUrl,
  type Breadcrumb,
  type WebPageSchemaInput,
} from '../lib/structured-data';

interface Props {
  title: string;
  description: string;
  pageType?: WebPageSchemaInput['type'];
  breadcrumbs?: Breadcrumb[];
  extraSchema?: Record<string, unknown>[];
  ogImagePath?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageAlt?: string;
  noindex?: boolean;
  searchQuery?: string;
}

const {
  title,
  description,
  pageType = 'WebPage',
  breadcrumbs = [],
  extraSchema = [],
  ogImagePath = BERVEX_SITE.ogImagePath,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageAlt = 'Logo BERVEX: urso geométrico dourado e prata',
  noindex = false,
  searchQuery = '',
} = Astro.props;

const path = Astro.url.pathname;
const canonical = toAbsoluteUrl(BERVEX_SITE, path);
const ogImage = toAbsoluteUrl(BERVEX_SITE, ogImagePath);

const schemaNodes = [
  buildOrganizationSchema(BERVEX_SITE),
  buildWebSiteSchema(BERVEX_SITE),
  buildWebPageSchema(BERVEX_SITE, { path, title, description, type: pageType, imagePath: ogImagePath }),
  ...(breadcrumbs.length ? [buildBreadcrumbSchema(BERVEX_SITE, breadcrumbs)] : []),
  ...extraSchema,
];
---

<!doctype html>
<html lang="pt-BR" id="topo">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="theme-color" content="#0f0f0f" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={BERVEX_SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/brand/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/archivo-latin-wdth.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={buildSchemaGraph(schemaNodes)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <SiteHeader currentPath={path} searchQuery={searchQuery} />
    <main id="conteudo">
      <slot />
    </main>
    <SiteFooter />
    <WhatsAppFloat />
    <CartDrawer />

    <script>
      import { wireReveal } from '../scripts/reveal';
      import { wireTilt } from '../scripts/tilt';

      wireReveal(document, window);
      wireTilt(document, window);
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute; left: var(--margin); top: -4rem; z-index: 100;
    padding: 0.75rem 1rem; background: var(--gold); color: var(--black); font-weight: 700;
  }
  .skip-link:focus { top: 0.75rem; }
</style>
