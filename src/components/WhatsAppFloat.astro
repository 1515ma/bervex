---
import { BERVEX_SITE } from '../config/site';
import { buildWhatsAppLink } from '../lib/whatsapp-link';

const href = buildWhatsAppLink(BERVEX_SITE.whatsappNumber, 'Olá, BERVEX! Vim pelo site e quero um orçamento.');
---

<a class="whatsapp-float" href={href} target="_blank" rel="noopener" aria-label="Falar com a BERVEX no WhatsApp">
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M16.04 3C8.86 3 3.02 8.83 3.02 16c0 2.3.6 4.53 1.74 6.5L3 29l6.68-1.74A13 13 0 0 0 16.04 29C23.2 29 29 23.17 29 16S23.2 3 16.04 3Zm0 23.8c-1.98 0-3.92-.53-5.6-1.54l-.4-.24-3.97 1.03 1.06-3.86-.26-.4A10.76 10.76 0 0 1 5.24 16c0-5.95 4.85-10.8 10.8-10.8 5.94 0 10.76 4.85 10.76 10.8 0 5.96-4.82 10.8-10.76 10.8Zm5.92-8.08c-.32-.16-1.92-.95-2.22-1.06-.3-.11-.51-.16-.73.16-.21.32-.84 1.06-1.03 1.27-.19.22-.38.24-.7.08-.33-.16-1.37-.5-2.6-1.6-.96-.86-1.61-1.92-1.8-2.24-.19-.33-.02-.5.14-.66.15-.15.33-.38.49-.57.16-.19.21-.33.32-.54.1-.22.05-.4-.03-.57-.08-.16-.72-1.75-1-2.39-.26-.63-.53-.54-.73-.55h-.62c-.21 0-.56.08-.86.4-.3.33-1.13 1.1-1.13 2.69 0 1.58 1.16 3.12 1.32 3.33.16.22 2.28 3.48 5.52 4.88.77.33 1.37.53 1.84.68.77.25 1.48.21 2.03.13.62-.1 1.92-.79 2.19-1.55.27-.76.27-1.42.19-1.55-.08-.14-.3-.22-.62-.38Z"
    ></path>
  </svg>
</a>

<style>
  .whatsapp-float {
    position: fixed; right: max(1rem, env(safe-area-inset-right)); bottom: max(1rem, env(safe-area-inset-bottom)); z-index: 60;
    display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%;
    background: var(--gold); color: var(--black);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.22); /* taste-skill-ignore: botão fixo que flutua sobre o conteúdo */
    transition: transform var(--t-press) var(--ease-out), background-color var(--t-hover) ease;
  }
  .whatsapp-float:active { transform: scale(0.95); }
  @media (hover: hover) and (pointer: fine) { .whatsapp-float:hover { background: var(--gold-hover); } }
  @media (prefers-reduced-motion: no-preference) {
    .whatsapp-float { animation: float-in 500ms var(--ease-out) 900ms both; }
  }
  @keyframes float-in { from { opacity: 0; transform: translateY(16px); } }

</style>
